      "id": "3577d719-ddcc-4abe-981c-d6ce000ef790",
      "name": "Help Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        980,
        620
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH today AS (\n  SELECT id, total FROM orders\n  WHERE status = 'completed'\n    AND created_at >= (date_trunc('day', now() AT TIME ZONE 'Asia/Jakarta') AT TIME ZONE 'Asia/Jakarta')\n),\ntop AS (\n  SELECT oi.name, SUM(oi.qty) AS qty, SUM(oi.subtotal) AS revenue\n  FROM order_items oi JOIN today t ON t.id = oi.order_id\n  GROUP BY oi.name ORDER BY qty DESC LIMIT 5\n)\nSELECT $1::text AS chat_id,\n       (SELECT COUNT(*) FROM today) AS order_count,\n       (SELECT COALESCE(SUM(total), 0) FROM today) AS revenue,\n       COALESCE((SELECT jsonb_agg(to_jsonb(top)) FROM top), '[]'::jsonb) AS top_items;",
        "options": {
          "queryReplacement": "={{ $json.chat_id }}"
        }
      },
      "id": "eab9233c-c679-4748-8876-0855f671cda5",
      "name": "Report Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        980,
        140
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fmt = n => 'Rp' + String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst r = $input.first().json;\nconst date = new Date().toLocaleDateString('en-US', { timeZone: 'Asia/Jakarta', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\nlet t = 'Sales Report\\n' + date + '\\n\\nOrders: ' + r.order_count + '\\nRevenue: ' + fmt(r.revenue);\nconst top = r.top_items || [];\nif (top.length) t += '\\n\\nTop items:\\n' + top.map((x, i) => (i + 1) + '. ' + x.name + ' - ' + x.qty + ' sold (' + fmt(x.revenue) + ')').join('\\n');\nelse t += '\\n\\nNo sales yet today.';\nreturn [{ json: { chat_id: r.chat_id, reply_text: t } }];"
      },
      "id": "4165ef10-db40-4f0a-b31c-41f6438e04bd",
      "name": "Format Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        140
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS chat_id,\n       COALESCE(jsonb_agg(jsonb_build_object('name', name, 'stock', stock, 'min_stock', min_stock) ORDER BY stock, name), '[]'::jsonb) AS items\nFROM menu WHERE active AND track_stock;",
        "options": {
          "queryReplacement": "={{ $json.chat_id }}"
        }
      },
      "id": "4c67d383-c0f6-45fa-a3ed-a1dd0a6d33bd",
      "name": "Stock Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        980,
        280
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst items = r.items || [];\nlet t = 'Menu Stock\\n\\n';\nif (!items.length) t += 'No menu items with stock tracking yet.';\nelse t += items.map(x => x.name + ': ' + x.stock + (Number(x.stock) <= Number(x.min_stock) ? '  (LOW)' : '')).join('\\n');\nreturn [{ json: { chat_id: r.chat_id, reply_text: t } }];"
      },
      "id": "210e1db3-f2ba-40e8-a52f-06781e505f85",
      "name": "Format Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        280
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS chat_id,\n       COALESCE(jsonb_agg(jsonb_build_object('name', name, 'price', price, 'stock', stock, 'track_stock', track_stock) ORDER BY name), '[]'::jsonb) AS items\nFROM menu WHERE active;",
        "options": {
          "queryReplacement": "={{ $json.chat_id }}"
        }
      },
      "id": "3709b358-e8c2-4784-b47e-28e8bbef9e58",
      "name": "Menu Query",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        980,
        440
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fmt = n => 'Rp' + String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst r = $input.first().json;\nconst items = r.items || [];\nlet t = 'Menu\\n\\n';\nif (!items.length) t += 'The menu is empty.';\nelse t += items.map(x => x.name + ' - ' + fmt(x.price) + (x.track_stock ? ' (stock ' + x.stock + ')' : '')).join('\\n');\nreturn [{ json: { chat_id: r.chat_id, reply_text: t } }];"
      },
      "id": "38eb5774-3031-4105-9b28-0e05a60df7c5",
      "name": "Format Menu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        440
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, aliases, price, stock, min_stock, track_stock FROM menu WHERE active ORDER BY name;",
        "options": {}
      },
      "id": "3749ecab-10d0-4df7-98d1-cc8a25e2d9c8",
      "name": "Fetch Menu for Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        980,
        800
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ID",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst tg = $('Normalize Message').first().json;\nconst menu_text = rows.length\n  ? rows.map(r => '- ' + r.name + ((r.aliases || []).length ? ' (aliases: ' + r.aliases.join(', ') + ')' : '')).join('\\n')\n  : '(menu is empty)';\nreturn [{ json: {\n  chat_id: tg.chat_id, update_id: tg.update_id, text: tg.text, from_name: tg.from_name,\n  menu: rows, menu_text\n} }];"
      },
      "id": "d339785f-bd2f-4550-90d3-ac4038016d39",
      "name": "Prepare Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        800
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'MENU LIST:\\n' + $json.menu_text + '\\n\\nCASHIER MESSAGE:\\n' + $json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an order parser for a small food stall. Your job is to turn the cashier's message into structured JSON.\n\nRULES:\n- An official menu list is provided. Match each item in the message to the closest menu item (tolerate typos and abbreviations). Write the item name EXACTLY as it appears in the menu list.\n- If an item is not on the menu, write its original name as-is. Never invent menu items.\n- If no quantity is given, qty = 1. Quantities may be written as words (one, two, three, ...).\n- If the message is not an order (greeting, question, etc.), set intent = \"other\" and items = [].\n- Fill customer_name if one is mentioned (e.g. \"for Budi\", \"under the name Sari\"), otherwise use an empty string.\n- Fill note with special requests (e.g. \"not spicy\", \"takeaway\"), otherwise use an empty string.\n- Do not calculate prices. Output ONLY JSON that matches the schema."
            }
          ]
        }
      },
      "id": "9d0f99c1-6c04-484d-9bb4-799fc0ff9051",
      "name": "Parse Order (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1460,
        800
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "0fdedc4b-fb1f-461c-979a-edfc65eb6410",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1400,
        1040
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"intent\": \"order\",\n  \"customer_name\": \"Budi\",\n  \"note\": \"not spicy\",\n  \"items\": [\n    {\n      \"name\": \"Nasi Goreng\",\n      \"qty\": 2\n    },\n    {\n      \"name\": \"Es Teh\",\n      \"qty\": 1\n    }\n  ]\n}"
      },
      "id": "2728672d-2699-4430-9f18-6a0776d1d06a",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1580,
        1040
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Context').first().json;\nconst raw = $('Parse Order (LLM)').first().json;\nlet parsed = raw.output ?? raw.text ?? raw.response ?? raw;\nif (typeof parsed === 'string') { try { parsed = JSON.parse(parsed); } catch (e) { parsed = {}; } }\nif (parsed && parsed.output && typeof parsed.output === 'object') parsed = parsed.output;\nparsed = parsed || {};\n\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9\\s]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst base = { chat_id: ctx.chat_id, update_id: ctx.update_id };\nconst menu = (ctx.menu || []).map(m => ({ ...m, keys: [m.name, ...(m.aliases || [])].map(norm) }));\n\nif (parsed.intent !== 'order' || !Array.isArray(parsed.items) || parsed.items.length === 0) {\n  return [{ json: { ...base, ok: false,\n    reply_text: 'That message was not recognized as an order.\\n\\nExample: \"2 nasi goreng, 1 es teh for Budi\"\\nSend /help for the list of commands.' } }];\n}\n\nconst errors = [];\nconst agg = new Map();\nfor (const it of parsed.items) {\n  const qty = Math.round(Number(it.qty));\n  if (!Number.isFinite(qty) || qty < 1 || qty > 99) { errors.push('Invalid quantity for \"' + it.name + '\"'); continue; }\n  const m = menu.find(x => x.keys.includes(norm(it.name)));\n  if (!m) { errors.push('Menu item not found: \"' + it.name + '\"'); continue; }\n  agg.set(m.id, (agg.get(m.id) || 0) + qty);\n}\n\nconst items = [];\nlet total = 0;\nfor (const [id, qty] of agg) {\n  const m = menu.find(x => x.id === id);\n  if (m.track_stock && Number(m.stock) < qty) {\n    errors.push('Not enough stock for ' + m.name + ' (' + m.stock + ' left, ' + qty + ' requested)');\n    continue;\n  }\n  const subtotal = Number(m.price) * qty;\n  total += subtotal;\n  items.push({ menu_id: m.id, name: m.name, qty, unit_price: Number(m.price), subtotal });\n}\n\nif (errors.length) {\n  return [{ json: { ...base, ok: false,\n    reply_text: 'Order not processed:\\n- ' + errors.join('\\n- ') + '\\n\\nPlease correct it and send it again.' } }];\n}\n\nreturn [{ json: { ...base, ok: true,\n  customer_name: String(parsed.customer_name || '').trim(),\n  note: String(parsed.note || '').trim(),\n  total, items, items_json: JSON.stringify(items) } }];"
      },
      "id": "25f48054-0e62-4b25-97d5-0245880e62ad",
      "name": "Validate & Calculate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        800
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3255f7c7-1b59-4cbb-b9c3-968015da7793",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2ea33fc2-6c69-4a20-bd0f-090380f81c5e",
      "name": "Order Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
