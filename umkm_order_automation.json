      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new_order AS (\n  INSERT INTO orders (telegram_update_id, chat_id, customer_name, total, note)\n  VALUES ($1::bigint, $2::bigint, NULLIF($3::text, ''), $4::numeric, NULLIF($5::text, ''))\n  ON CONFLICT (telegram_update_id) DO NOTHING\n  RETURNING id, created_at\n),\nins AS (\n  INSERT INTO order_items (order_id, menu_id, name, qty, unit_price, subtotal)\n  SELECT n.id, (i->>'menu_id')::int, i->>'name', (i->>'qty')::int,\n         (i->>'unit_price')::numeric, (i->>'subtotal')::numeric\n  FROM new_order n, jsonb_array_elements($6::jsonb) AS i\n  RETURNING menu_id, qty\n),\nupd AS (\n  UPDATE menu m SET stock = m.stock - s.qty\n  FROM (SELECT menu_id, SUM(qty) AS qty FROM ins GROUP BY menu_id) s\n  WHERE m.id = s.menu_id AND m.track_stock\n  RETURNING m.name, m.stock, m.min_stock\n)\nSELECT n.id AS order_id,\n       COALESCE((SELECT jsonb_agg(jsonb_build_object('name', name, 'stock', stock))\n                 FROM upd WHERE stock <= min_stock), '[]'::jsonb) AS low_stock\nFROM new_order n;",
        "options": {
          "queryReplacement": "={{ [ $json.update_id, $json.chat_id, $json.customer_name, $json.total, $json.note, $json.items_json ] }}"
        }
      },
      "id": "734dd5d3-accf-4b3a-8c1d-d5312c4e84ad",
      "name": "Save Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
