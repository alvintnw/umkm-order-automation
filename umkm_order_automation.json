    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fmt = n => 'Rp' + String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst ctx = $('Validate & Calculate').first().json;\nconst res = $input.first().json;\nlet t = 'Order #' + res.order_id + ' saved' + (ctx.customer_name ? ' - ' + ctx.customer_name : '') + '\\n\\n';\nt += ctx.items.map(i => i.qty + 'x ' + i.name + ' @ ' + fmt(i.unit_price) + ' = ' + fmt(i.subtotal)).join('\\n');\nt += '\\n\\nTotal: ' + fmt(ctx.total);\nif (ctx.note) t += '\\nNote: ' + ctx.note;\nconst low = res.low_stock || [];\nif (low.length) t += '\\n\\nLow stock: ' + low.map(x => x.name + ' (' + x.stock + ' left)').join(', ');\nreturn [{ json: { chat_id: ctx.chat_id, reply_text: t } }];"
